{
  "name": "training-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/supabase-cli.mjs start --exclude realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor --ignore-health-check && node scripts/local-ready.mjs",
    "db:stop": "node scripts/supabase-cli.mjs stop",
    "db:migrate": "node scripts/supabase-cli.mjs migration up --local",
    "test:setup": "node scripts/local-qa.mjs setup",
    "test:clean": "node scripts/local-qa.mjs clean",
    "test:api": "python3 tests/api-qa.py",
    "test:workflow": "python3 tests/workflow-qa.py",
    "test:browser": "node tests/browser-qa.mjs",
    "test:supabase": "node tests/supabase-qa.mjs",
    "dev:local": "node scripts/local-dev.mjs",
    "build:local": "node scripts/local-dev.mjs build",
    "start:local": "node scripts/local-dev.mjs start",
    "test:core": "node tests/typing-metrics.mjs && python3 tests/core-workflow.py",
    "test:core:browser": "node tests/core-browser.mjs && node tests/typing-legacy-browser.mjs",
    "test:reliability": "node tests/candidate-reliability.mjs",
    "test:settings": "node tests/settings-browser.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "playwright": "^1.63.0",
    "supabase": "^2.119.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
